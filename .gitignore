# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Log
*.log

# Jetbrains IDE
.idea

# Node/Deno
node_modules

# TS intermediate build output (tsc -> rollup -> terser)
build/

# Temp files created while post-processing .d.ts, see "dev.py bundle"
.00__web.d.ts
.01__rsvim.d.ts

# Generated Typedoc
generated-typedocs

# Mac
.DS_Store

# Snapshot
RSVIM_SNAPSHOT.BIN
RSVIM_VERSION.TXT

# Build binaries
*.dylib
*.dll
*.so
